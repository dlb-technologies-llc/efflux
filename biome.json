{
	"$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"apps/**",
			"packages/**",
			"scripts/**",
			"!**/dist",
			"!**/*.svg",
			"!**/worker-configuration.d.ts",
			"!.claude/effect-smol",
			"!apps/web/src/components/ui",
			"!apps/web/src/index.css",
			"!**/node_modules"
		]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "error"
			},
			"complexity": {
				"useLiteralKeys": "off"
			},
			"correctness": {
				"useExhaustiveDependencies": "off"
			},
			"suspicious": {
				"noShadowRestrictedNames": "off",
				"noArrayIndexKey": "off"
			}
		}
	},
	"assist": {
		"enabled": false
	}
}
