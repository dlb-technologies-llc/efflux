{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "effect-flue",
  "account_id": "0e23a33dd52d75e88e3e6a75d617d302",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents", "/agents/*", "/tasks", "/tasks/*", "/skills", "/skills/*", "/knowledge", "/knowledge/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "AGENTS", "class_name": "Agent" },
      { "name": "SANDBOX", "class_name": "Sandbox" },
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Agent", "Sandbox"] },
    { "tag": "v2", "new_sqlite_classes": ["Registry"] }
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./apps/api/container/Dockerfile",
      "instance_type": "standard-1"
    }
  ],
  "r2_buckets": [
    { "binding": "SKILLS", "bucket_name": "effect-flue-skills" },
    { "binding": "SESSIONS", "bucket_name": "effect-flue-sessions" }
  ],
  "ai_search": [
    { "binding": "KNOWLEDGE_SEARCH", "instance_name": "effect-flue-knowledge", "remote": true }
  ],
  "triggers": { "crons": ["0 12 * * *"] },
  "observability": { "enabled": true }
}
